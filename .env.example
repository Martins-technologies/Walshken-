# For Vercel runtime. Local npm run dev uses a persistent PGlite database if omitted.
DATABASE_URL=
# Optional dedicated connection for schema migrations.
DIRECT_DATABASE_URL=
# An authorized work email and a randomly generated setup code of at least 24 characters.
WALSHKEN_ADMIN_EMAIL=
WALSHKEN_SETUP_CODE=
# 32 random bytes in base64. Required before saving integration credentials.
WALSHKEN_INTEGRATION_KEY=
# Set the HTTPS origin of the verified custom domain. Preview is excluded from indexing.
WALSHKEN_SITE_URL=
WALSHKEN_INDEX_PUBLIC=0

# Set to 1 to require authenticator enrollment before using the staff workspace.
WALSHKEN_REQUIRE_STAFF_MFA=0

# Required for scheduled call expiry, access reconciliation and recording deletion.
# Set privately in Vercel Preview/Production as appropriate, never NEXT_PUBLIC_.
CRON_SECRET=
# Optional self-hosted LiveKit hosts. Leave unset when using LiveKit Cloud.
WALSHKEN_LIVEKIT_ALLOWED_HOSTS=

# Versioned encryption. For an existing portal, use the authenticated migration
# while the legacy key remains configured on the original server.
WALSHKEN_INTEGRATION_KEY_V2=

# Part G: enable only on the isolated review branch until acceptance.
WALSHKEN_PAYROLL_ENABLED=0
WALSHKEN_PAYROLL_DATASET=preview
# Additional jurisdictions require an independently validated payroll-v1 calculator.
WALSHKEN_PAYROLL_INTEGRATION_ID=payroll-calculator-review
WALSHKEN_PAYROLL_ALLOWED_HOSTS=

# Part H, enable only on its isolated Preview branch until accepted
WALSHKEN_HOLIDAYS_ENABLED=0
WALSHKEN_HOLIDAY_DATASET=preview

# Unified staff calendar
WALSHKEN_CALENDAR_ENABLED=0

# Enable after the messaging document-reference migration is applied.
WALSHKEN_MESSAGE_DOCUMENTS_ENABLED=0

# Optional protected deployment defaults for LiveKit and private S3.
# JSON of livekit, recording-storage and/or document-storage-review settings.
# Keep the value in Vercel Secrets. Saved dashboard settings take precedence,
# including explicit disable. No secret is returned by integration status APIs.
WALSHKEN_SERVER_INTEGRATIONS=
# Opt-in deployment preflight checks authentication and private storage access.
WALSHKEN_VERIFY_SERVER_INTEGRATIONS=0

# Set 0 explicitly only when malware scanning is deferred by the operator.
# Private storage, format validation, rendering checks and ACLs stay active.
WALSHKEN_MALWARE_SCANNING_REQUIRED=1

# Enable only on the reviewed deployment after its schema migration.
WALSHKEN_SOURCE_DISPOSAL_ENABLED=0
WALSHKEN_EMPLOYER_VALIDATION_ENABLED=0
